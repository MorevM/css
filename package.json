{
	"name": "@morev/css",
	"description": "Modern CSS foundation",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"version": "0.0.0",
	"engines": {
		"node": ">=24"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"author": {
		"name": "Maxim Morev",
		"email": "max.seainside@gmail.com"
	},
	"homepage": "https://github.com/MorevM/css#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/MorevM/css"
	},
	"bugs": {
		"url": "https://github.com/MorevM/css/issues"
	},
	"keywords": [
		"baseline",
		"css",
		"css-reset",
		"design-system",
		"reset"
	],
	"files": [
		"dist"
	],
	"exports": {
		"./reset.css": "./dist/reset.css",
		"./reset.min.css": "./dist/reset.min.css",
		"./reset/base.css": "./dist/reset/base.css",
		"./reset/base.min.css": "./dist/reset/base.min.css",
		"./reset/core.css": "./dist/reset/core.css",
		"./reset/core.min.css": "./dist/reset/core.min.css",
		"./reset/reduced-motion.css": "./dist/reset/reduced-motion.css",
		"./reset/reduced-motion.min.css": "./dist/reset/reduced-motion.min.css"
	},
	"scripts": {
		"prepare": "lefthook install",
		"playground": "vite --host --open /playground/",
		"test": "vitest",
		"test:dev": "vitest --watch",
		"typecheck": "tsc --noEmit",
		"spellcheck": "cspell --no-progress --no-must-find-files --show-suggestions --unique",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint",
		"lint:fix": "pnpm lint:eslint:fix && pnpm lint:stylelint:fix",
		"lint:eslint": "eslint .",
		"lint:eslint:fix": "eslint . --fix",
		"lint:stylelint": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
		"lint:stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix --allow-empty-input",
		"build": "pnpm run build:css",
		"build:css": "node ./scripts/build-css.js",
		"release": "release-it --disable-metrics"
	},
	"devDependencies": {
		"@cspell/dict-ru_ru": "^2.3.2",
		"@morev/commitlint-config": "^0.2.2",
		"@morev/eslint-config": "^42.0.2",
		"@morev/stylelint-config": "^9.0.2",
		"@morev/utils": "^3.15.0",
		"@release-it/conventional-changelog": "^8.0.1",
		"@types/node": "^24.12.2",
		"cspell": "^10.0.1",
		"esbuild": "^0.25.12",
		"eslint": "10.7.0",
		"lefthook": "^2.1.10",
		"release-it": "^20.2.1",
		"stylelint": "^17.14.0",
		"tsdown": "^0.22.9",
		"typescript": "^6.0.3",
		"vite": "^6.3.5",
		"vitest": "^4.1.10"
	}
}
